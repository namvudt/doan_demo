# preview: isolated browser fixtures. api: the existing FastAPI server.
VITE_FRONTEND_MODE=preview
VITE_ALLOW_LIVE_MODEL_CALLS=false

# Same-origin API prefix. The Vite development proxy sends /api and /health
# to the isolated backend demo at http://127.0.0.1:8001.
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=30000

# Local, noncommercial demo tiles; empty uses the interactive offline diagram.
# For commercial deployment choose a provider whose usage terms fit your app.
VITE_MAP_TILE_URL=https://tile.openstreetmap.de/{z}/{x}/{y}.png

# Optional Mapbox raster provider. Use a public pk. token in an ignored local file.
# See docs/MAP_PROVIDER_EXPERIMENT.md; never use a secret sk. token in the browser.
VITE_MAP_PROVIDER=auto
VITE_MAPBOX_ACCESS_TOKEN=
