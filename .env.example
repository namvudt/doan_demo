# Environment configuration for config/default.yaml
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# LangSmith monitoring (optional). Keep real credentials only in ignored .env.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=heritage-vqa-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
# Inputs, images, outputs, source snippets and error details are redacted in code.

# Optional alternate provider; bind roles explicitly in config/default.yaml.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Optional per-role overrides; no provider inference from the key prefix.
# KNOWLEDGE_PROVIDER=gemini
# KNOWLEDGE_MODEL=gemini-3.8-flash
# KNOWLEDGE_API_KEY=
# JUDGE_API_KEY=

# Optional GPU server, enabled only by explicit role/provider configuration.
# LOCAL_INFERENCE_URL=http://127.0.0.1:8000/v1
# LOCAL_INFERENCE_API_KEY=local
# HERITAGE_CONFIG=config/default.yaml

# HTTP API: Swagger UI at http://127.0.0.1:8000/docs
API_ENV=development
API_MODEL_MODE=live
API_EMBEDDED_WORKER=true
API_DATA_DIR=data
DATABASE_URL=sqlite:///data/api.sqlite
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_SESSION_TTL_SECONDS=604800
API_MAX_ACTIVE_PER_OWNER=3
API_MAX_RUNS_PER_DAY=100
API_MAX_PENDING_RUNS=100
# Required in production. Keep actual values only in .env/deployment secrets.
# API_BOOTSTRAP_TOKEN=
# POSTGRES_PASSWORD=

# Optional: run Streamlit as an HTTP frontend instead of executing locally.
# HERITAGE_API_URL=http://127.0.0.1:8000
# HERITAGE_API_TOKEN=
