# ==============================================================
# CẤU HÌNH API KEYS CHO MULTI-AGENT VQA SYSTEM
# ==============================================================

# Khóa API Google Gemini (Dành cho Visual Agent, OCR Agent & Fallback)
# Lấy tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Khóa API OpenAI (Dành cho Knowledge Agent, Generation Agent & Fallback)
# Lấy tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Cấu hình Model ưu tiên (Tuỳ chọn)
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
