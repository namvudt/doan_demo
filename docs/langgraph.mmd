---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	scope(scope)
	coordinate(coordinate)
	visual(visual)
	knowledge(knowledge)
	generation(generation)
	aggregate(aggregate)
	judge(judge)
	experts_done(experts_done)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> scope;
	aggregate -.-> finish;
	aggregate -.-> judge;
	coordinate -.-> finish;
	coordinate -.-> knowledge;
	coordinate -.-> visual;
	experts_done -.-> aggregate;
	experts_done -.-> finish;
	experts_done -.-> generation;
	generation --> aggregate;
	judge --> finish;
	knowledge --> experts_done;
	scope -.-> coordinate;
	scope -.-> finish;
	visual --> experts_done;
	finish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
